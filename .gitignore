# =========================
# Python standard ignores
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =========================
# OS generated files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================
# IDEs and Editors
# =========================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# =========================
# Project Specific
# =========================
# Ignore text files in the root so you don't accidentally commit target lists
/*.txt
!requirements.txt
!examples/*.txt

# Ignore json files in the root so you don't leak recon results
/*.json
!examples/*.json